DATA_PATH=../nui_ba_den_tourism_database.xlsx
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=nui_ba_den_rag
AUTO_BUILD_CHROMA_ON_STARTUP=false
RAG_AUTO_REFRESH=true
DATA_REFRESH_SECONDS=300
SUNWORLD_LIVE_SEARCH=true
SUNWORLD_SEARCH_TIMEOUT_SECONDS=8
SUNWORLD_CACHE_SECONDS=900
SUNWORLD_SEARCH_MAX_PAGES=3

# Tim kiem web tong quat (Tavily). De trong thi chatbot van dung RAG va
# nguon chinh thuc Sun World, nhung se khong tim duoc cac website khac.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_CACHE_SECONDS=900
WEB_SEARCH_MAX_RESULTS=3
WEB_KNOWLEDGE_RETENTION_DAYS=90
WEB_KNOWLEDGE_MAX_CONTEXTS=4
APP_ENV=production
DEBUG_RETRIEVAL=false

# Supabase Postgres. Dung connection string pooler, vi du:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=

# OpenAI-compatible router, vi du 9router/OpenRouter/local gateway.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.9router.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_TOKENS=900
OPENAI_TEMPERATURE=0.55

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_ALLOW_DOWNLOAD=true
RAG_TOP_K=8
RAG_MIN_RELEVANCE_SCORE=0.05

CORS_ORIGINS=https://ai-ecotourism-assistant.vercel.app,http://localhost:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
LOG_LEVEL=INFO
